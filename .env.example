# Required: get a key at https://aistudio.google.com/apikey
# Put the real key in .env only. Never in this file.
GEMINI_API_KEY=

# Models (defaults shown)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Embeddings. "gemini" uses the Gemini API and needs almost no memory.
# "local" runs a model on this machine: install requirements-local.txt and keep about 1.2 GB free.
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Storage
CHROMA_PATH=./chroma_db

# Upload limits (per user)
MAX_FILE_MB=20
MAX_PAGES_PER_FILE=100
MAX_DOCS_PER_USER=15
MAX_TOTAL_PAGES=500

# Retrieval tuning. Leave SIMILARITY_THRESHOLD unset to use the default for your embedding provider
# (0.60 for gemini, 0.80 for local). Only set it after measuring.
# SIMILARITY_THRESHOLD=
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MIN_PAGE_CHARS=50
HISTORY_TURNS=4

# OCR for scanned PDFs and images
OCR_CACHE_PATH=./ocr_cache
OCR_LANGS=eng+hin
OCR_CONFIDENCE_THRESHOLD=60
OCR_DPI=200
# Only needed if Tesseract is installed but not found automatically:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Users, limits and retention
# Comma-separated Google emails allowed to sign in. Empty means nobody can.
ALLOWED_EMAILS=
# Local testing only: skips Google sign-in and uses one user called "local".
AUTH_DISABLED=false
SQLITE_PATH=./gilto.db
HOURLY_QUESTION_LIMIT=30
DAILY_TOKEN_LIMIT=200000
MONTHLY_TOKEN_CAP=5000000
INACTIVE_DAYS=90

# Search and evaluation
# Vector search plus keyword search, merged by rank fusion. Set false to use vector search only.
HYBRID_SEARCH=true
# Pause between questions in `python -m pytest -m eval -s`, to stay under rate limits.
EVAL_DELAY_SECONDS=4